%global _name OpenRGBHardwareSyncPlugin

Name:           openrgb-plugin-hardware-sync
Version:        __VERSION__
Release:        0%{?dist}
Summary:        Hardware sync plugin for OpenRGB

License:        GPLv2
URL:            https://gitlab.com/OpenRGBDevelopers/%{_name}

BuildRequires:  gcc-c++ libusbx-devel libstdc++-devel qt6-qtbase-devel qt6-linguist desktop-file-utils systemd-rpm-macros lm_sensors-devel glib2-devel libgtop2-devel
requires:       hicolor-icon-theme lm_sensors-libs glib2 libgtop2

%description
Hardware sync plugin for OpenRGB

%prep
cp -r %{_sourcedir}/%{_name}/. %{_builddir}

%build
cd %{_builddir}
export CXXFLAGS=${CXXFLAGS/-pipe}
%qmake_qt6 PREFIX=%{_prefix}
%make_build

%install
%make_install INSTALL_ROOT=%{buildroot}

%files
%{_exec_prefix}/lib/openrgb/plugins/libOpenRGBHardwareSyncPlugin.so
%{_exec_prefix}/share/metainfo/org.openrgb.OpenRGB.Plugin.HardwareSync.metainfo.xml

%changelog
* Fri Sep 11 2026 Adam Honse <calcprogrammer1@gmail.com> - 1.0-0
- Release 1.0

* Fri Aug 21 2026 Adam Honse <calcprogrammer1@gmail.com> - 0.9-0
- Initial package
